Options -Indexes
DirectoryIndex api.php

RewriteEngine On

# Never expose environment/config files through the public directory.
<FilesMatch "^\.(env|git)|\.(ini|log|sql)$">
    Require all denied
</FilesMatch>

# Route extensionless API paths to api.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ api.php [QSA,L]
